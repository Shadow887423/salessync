# ============================================================
# SalesSync — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# Run 'php artisan key:generate' after creating .env
# ============================================================

APP_NAME=SalesSync
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (Default: SQLite for zero-setup local dev)
DB_CONNECTION=sqlite
# For MySQL in Production / Docker:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sales_dashboard
# DB_USERNAME=salessync_app
# DB_PASSWORD=your_strong_password_here
# MYSQL_ATTR_SSL_CA=/path/to/ca-certificates.crt

# Application Cache & Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Security & CORS (Comma-separated list of allowed web origins)
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
